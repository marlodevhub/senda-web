# URL interna de senda-api; el navegador nunca la ve directamente, solo el BFF.
BACKEND_URL=http://localhost:8080

# Ingresar con Google (CU-18/CU-20), opcional. Mismo client ID que GOOGLE_CLIENT_ID de senda-api (OAuth tipo
# "Aplicación web", orígenes autorizados: http://localhost:3000 en dev y el dominio en staging/prod).
# Vacío = no se muestra el botón y la política de contenido no permite nada de Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
