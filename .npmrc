# @vitejs/plugin-react (vía @rolldown/plugin-babel) todavía no resuelve bien
# sus peers contra el Babel 8 beta que arrastra el resto del árbol. legacy
# evita que `npm ci` falle en CI por el mismo choque que da `npm install`
# en local hoy. Revisar si se puede quitar cuando esas libs publiquen un
# release estable.
legacy-peer-deps=true
